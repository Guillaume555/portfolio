---
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import Apercu from "../../components/Apercu.astro";
import AvantApres from "../../components/AvantApres.astro";
import Paire from "../../components/Paire.astro";

// une page par projet, avec le projet suivant pour la navigation en bas
export async function getStaticPaths() {
  const projets = (await getCollection("projets")).sort((a, b) => a.data.ordre - b.data.ordre);
  return projets.map((projet, i) => ({
    params: { id: projet.id },
    props: { projet, suivant: projets[(i + 1) % projets.length] },
  }));
}

const { projet, suivant } = Astro.props;
const { Content } = await render(projet);
const p = projet.data;
const aUnSite = p.lienSite?.startsWith("http");
const aDuTexte = Boolean(projet.body?.trim());
const num = (i: number) => String(i + 1).padStart(2, "0");

const titreSection = "font-titre text-2xl font-extrabold tracking-tight md:text-3xl";
const etiquette = "text-sm font-medium tracking-wide text-corail uppercase";
---
<Layout titre={`${p.titre} | Étude de cas | Guillaume Papalia`} description={p.resume}>
  <Header />

  <main class="mx-auto max-w-[1120px] px-6 pb-16">
    <a href="/#projets" class="text-sm font-medium text-accent hover:underline">← Retour aux projets</a>

    <!-- en-tête -->
    <header class="mt-8 max-w-3xl">
      <div class="flex flex-wrap items-center gap-3">
        <span class="rounded-full bg-accent-doux px-3 py-1 text-xs font-medium tracking-wider text-accent uppercase">{p.type}</span>
        <span class="text-sm text-texte-doux">{p.annee}</span>
      </div>
      <h1 class="mt-5 font-titre text-4xl font-extrabold tracking-tight md:text-6xl">{p.titre}<span class="text-corail">.</span></h1>
      <p class="mt-3 text-xl font-medium md:text-2xl">{p.accroche}</p>
      <p class="mt-4 text-lg text-texte-doux">{p.resume}</p>

      {(aUnSite || p.lienCode?.startsWith("http")) && (
        <div class="mt-6 flex flex-wrap gap-3">
          {aUnSite && <a href={p.lienSite} target="_blank" rel="noopener" class="inline-flex min-h-11 items-center gap-2 rounded-full bg-texte px-5 text-sm font-medium text-fond transition hover:bg-accent">Voir le site <span aria-hidden="true">↗</span></a>}
          {p.lienCode?.startsWith("http") && <a href={p.lienCode} target="_blank" rel="noopener" class="inline-flex min-h-11 items-center gap-2 rounded-full border-2 border-texte px-5 text-sm font-medium transition hover:border-accent hover:text-accent">Voir le code <span aria-hidden="true">↗</span></a>}
        </div>
      )}
    </header>

    {p.infos.length > 0 && (
      <dl class="mt-10 grid gap-px overflow-hidden rounded-[20px] border border-bordure bg-bordure sm:grid-cols-2 lg:grid-cols-4">
        {p.infos.map((info) => (
          <div class="bg-surface p-5">
            <dt class="text-xs font-medium tracking-wide text-texte-doux uppercase">{info.label}</dt>
            <dd class="mt-1 font-medium">{info.valeur}</dd>
          </div>
        ))}
      </dl>
    )}

    <div class="mt-10 overflow-hidden rounded-[28px]">
      <Apercu capture={p.capture} domaine={p.domaine ?? p.titre} titre={p.titre} teinte={p.teinte} grand />
    </div>

    <!-- contexte et problème -->
    {(p.contexte || p.probleme) && (
      <section class="mt-20 grid gap-10 md:grid-cols-2">
        {p.contexte && (
          <div>
            <p class={etiquette}>Contexte</p>
            <p class="mt-3 text-lg leading-relaxed">{p.contexte}</p>
          </div>
        )}
        {p.probleme && (
          <div>
            <p class={etiquette}>Le problème</p>
            <p class="mt-3 text-lg leading-relaxed">{p.probleme}</p>
            {p.chantiers.length > 0 && (
              <ol class="mt-4 space-y-2">
                {p.chantiers.map((c, i) => (
                  <li class="flex gap-3 text-texte-doux"><span class="font-titre font-extrabold text-accent">{num(i)}</span>{c}</li>
                ))}
              </ol>
            )}
          </div>
        )}
      </section>
    )}

    <!-- mon approche -->
    {p.approche.length > 0 && (
      <section class="mt-20">
        <p class={etiquette}>Mon approche</p>
        <h2 class:list={[titreSection, "mt-2"]}>Comment je m'y suis pris</h2>
        <div class="mt-8 grid gap-6 md:grid-cols-2">
          {p.approche.map((a, i) => (
            <article class="rounded-[20px] border border-bordure bg-surface p-6">
              <p class="font-titre text-3xl font-extrabold text-accent">{num(i)}</p>
              <h3 class="mt-2 font-titre text-xl font-extrabold">{a.titre}</h3>
              <p class="mt-2 leading-relaxed text-texte-doux">{a.texte}</p>
            </article>
          ))}
        </div>
      </section>
    )}

    <!-- avant / après -->
    {p.comparaisons.length > 0 && (
      <section class="mt-20">
        <p class={etiquette}>Avant / après</p>
        <h2 class:list={[titreSection, "mt-2"]}>Ce qui a changé à l'écran</h2>
        <div class="mt-8 space-y-14">
          {p.comparaisons.map((c) =>
            c.mode === "curseur"
              ? <AvantApres avant={c.avant} apres={c.apres} titre={c.titre} legende={c.legende} />
              : <Paire avant={c.avant} apres={c.apres} titre={c.titre} legende={c.legende} etroit={c.etroit} />
          )}
        </div>
      </section>
    )}

    {p.galerie.length > 0 && (
      <div class="mt-14 grid gap-6 md:grid-cols-2">
        {p.galerie.map((g) => (
          <figure>
            <img src={g.src} alt={g.legende} loading="lazy" class="w-full rounded-[20px] border border-bordure" />
            <figcaption class="mt-3 text-sm text-texte-doux">{g.legende}</figcaption>
          </figure>
        ))}
      </div>
    )}

    <!-- difficultés -->
    {p.difficultes.length > 0 && (
      <section class="mt-20">
        <p class={etiquette}>Difficultés</p>
        <h2 class:list={[titreSection, "mt-2"]}>Ce qui a résisté, et comment je l'ai réglé</h2>
        <div class="mt-8 space-y-4">
          {p.difficultes.map((d) => (
            <article class="grid gap-4 rounded-[20px] border border-bordure bg-surface p-6 md:grid-cols-[1fr_1fr] md:gap-8">
              <div>
                <h3 class="font-titre text-lg font-extrabold">{d.titre}</h3>
                <p class="mt-2 text-texte-doux">{d.probleme}</p>
              </div>
              <div class="border-t border-bordure pt-4 md:border-t-0 md:border-l md:pt-0 md:pl-8">
                <p class="text-xs font-medium tracking-wide text-accent uppercase">Solution</p>
                <p class="mt-2">{d.solution}</p>
              </div>
            </article>
          ))}
        </div>
      </section>
    )}

    <!-- deuxième site ou partie annexe -->
    {p.annexe && (
      <section class="mt-20 grid items-start gap-10 md:grid-cols-2">
        <div>
          <p class={etiquette}>Et aussi</p>
          <h2 class:list={[titreSection, "mt-2"]}>{p.annexe.titre}</h2>
          <p class="mt-4 leading-relaxed text-texte-doux">{p.annexe.texte}</p>
          {p.annexe.constats.length > 0 && (
            <>
              <h3 class="mt-6 font-medium">Ce que j'ai trouvé</h3>
              <ul class="mt-2 list-disc space-y-1 pl-5 text-texte-doux">{p.annexe.constats.map((c) => <li>{c}</li>)}</ul>
            </>
          )}
          {p.annexe.actions.length > 0 && (
            <>
              <h3 class="mt-6 font-medium">Ce que j'ai fait</h3>
              <ul class="mt-2 list-disc space-y-1 pl-5 text-texte-doux">{p.annexe.actions.map((a) => <li>{a}</li>)}</ul>
            </>
          )}
        </div>
        {p.annexe.image && (
          <figure>
            <img src={p.annexe.image} alt={p.annexe.legende ?? p.annexe.titre} loading="lazy" class="w-full rounded-[20px] border border-bordure" />
            {p.annexe.legende && <figcaption class="mt-3 text-sm text-texte-doux">{p.annexe.legende}</figcaption>}
          </figure>
        )}
      </section>
    )}

    <!-- stack -->
    {p.stackComplete.length > 0 && (
      <section class="mt-20">
        <p class={etiquette}>Stack</p>
        <ul class="mt-4 flex flex-wrap gap-2">
          {p.stackComplete.map((t) => <li class="rounded-full border border-bordure bg-surface px-3 py-1.5 text-sm">{t}</li>)}
        </ul>
      </section>
    )}

    <!-- résultats -->
    {p.resultats.length > 0 && (
      <section class="mt-20">
        <p class={etiquette}>Résultats</p>
        <h2 class:list={[titreSection, "mt-2"]}>Ce que ça a changé</h2>
        <div class="mt-8 grid gap-6 md:grid-cols-2">
          {p.resultats.map((r, i) => (
            <article class="flex gap-4">
              <p class="font-titre text-3xl font-extrabold text-corail">{num(i)}</p>
              <div>
                <h3 class="font-titre text-lg font-extrabold">{r.titre}</h3>
                <p class="mt-1 text-texte-doux">{r.texte}</p>
              </div>
            </article>
          ))}
        </div>
      </section>
    )}

    {p.autrement.length > 0 && (
      <section class="mt-20 rounded-[28px] bg-accent-doux p-8 md:p-12">
        <h2 class="font-titre text-2xl font-extrabold">Avec le recul, je ferais autrement</h2>
        <ul class="mt-4 list-disc space-y-2 pl-5">{p.autrement.map((a) => <li>{a}</li>)}</ul>
      </section>
    )}

    <!-- texte libre du fichier .md (projets sans étude de cas structurée) -->
    {aDuTexte && (
      <div class="contenu mt-16 max-w-3xl">
        <Content />
      </div>
    )}

    <!-- suite -->
    <section class="mt-20 grid gap-4 md:grid-cols-2">
      <a href="/#contact" class="group rounded-[28px] bg-texte p-8 text-fond transition hover:bg-accent">
        <p class="text-sm opacity-80">Un poste, un projet ?</p>
        <p class="mt-2 font-titre text-2xl font-extrabold">Parlons-en <span aria-hidden="true">→</span></p>
      </a>
      {suivant.id !== projet.id && (
        <a href={`/projets/${suivant.id}`} class="rounded-[28px] border border-bordure bg-surface p-8 transition hover:border-accent">
          <p class="text-sm text-texte-doux">Projet suivant</p>
          <p class="mt-2 font-titre text-2xl font-extrabold">{suivant.data.titre}<span class="text-corail">.</span> <span aria-hidden="true">→</span></p>
        </a>
      )}
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .contenu :global(h2) { margin-top: 2.5rem; font-family: var(--font-titre); font-size: 1.5rem; font-weight: 800; }
  .contenu :global(p), .contenu :global(ul) { margin-top: 0.75rem; color: var(--texte-doux); line-height: 1.7; }
  .contenu :global(ul) { list-style: disc; padding-left: 1.25rem; }
</style>
