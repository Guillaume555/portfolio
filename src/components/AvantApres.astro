---
// curseur avant / après : on fait glisser pour comparer les deux versions
const { avant, apres, titre, legende } = Astro.props;
---
<figure class="avant-apres">
  <div class="relative overflow-hidden rounded-[20px] border border-bordure bg-surface select-none" style="--pos: 50%">
    <img src={avant} alt={`${titre} : ancienne version`} loading="lazy" class="block w-full" />
    <img src={apres} alt={`${titre} : nouvelle version`} loading="lazy" class="absolute inset-0 h-full w-full object-cover object-top [clip-path:inset(0_0_0_var(--pos))]" />

    <span class="pointer-events-none absolute top-3 left-3 rounded-full bg-texte/80 px-3 py-1 text-xs font-medium text-fond">Avant</span>
    <span class="pointer-events-none absolute top-3 right-3 rounded-full bg-accent px-3 py-1 text-xs font-medium text-fond">Après</span>

    <!-- poignée -->
    <div class="pointer-events-none absolute inset-y-0 left-(--pos) w-0.5 -translate-x-1/2 bg-fond shadow-[0_0_0_1px_rgb(16_32_46/0.2)]">
      <span class="absolute top-1/2 left-1/2 flex h-10 w-10 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full bg-fond text-sm font-bold text-texte shadow-md">⇆</span>
    </div>

    <input type="range" min="0" max="100" value="50" aria-label={`Comparer avant et après : ${titre}`} class="absolute inset-0 h-full w-full cursor-ew-resize opacity-0" />
  </div>
  {legende && <figcaption class="mt-3 text-sm text-texte-doux"><span class="font-medium text-texte">{titre}.</span> {legende}</figcaption>}
</figure>

<script>
  document.querySelectorAll(".avant-apres input[type=range]").forEach((curseur) => {
    const input = curseur as HTMLInputElement;
    input.addEventListener("input", () => {
      input.parentElement?.style.setProperty("--pos", `${input.value}%`);
    });
  });
</script>
