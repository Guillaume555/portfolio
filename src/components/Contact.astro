---
import { moi } from "../data/site";
---
<section id="contact" class="mx-auto max-w-[1120px] px-6 py-16 md:py-24">
  <div class="rounded-[32px] bg-texte px-6 py-12 text-fond md:px-16 md:py-16">
    <p class="text-sm font-medium tracking-wide uppercase opacity-80">Contact</p>
    <h2 class="mt-2 max-w-2xl font-titre text-3xl font-extrabold tracking-tight md:text-5xl">
      Vous cherchez un alternant ? Parlons-en.
    </h2>
    <p class="mt-4 max-w-xl opacity-80">
      Disponible pour une alternance de 2 semaines en entreprise / 1 semaine à l'école, jusqu'en juillet 2027.
    </p>

    <div class="mt-8 flex flex-wrap items-center gap-4">
      <button id="copier-email" type="button" data-email={moi.email} class="inline-flex min-h-12 cursor-pointer items-center rounded-full bg-fond px-6 font-medium text-texte transition hover:bg-accent-doux">
        Copier mon email
      </button>
      <a href={`mailto:${moi.email}`} class="inline-flex min-h-12 items-center rounded-full border-2 border-fond px-6 font-medium transition hover:bg-fond hover:text-texte">
        M'écrire
      </a>
    </div>

    <ul class="mt-8 flex flex-wrap gap-6 text-sm font-medium">
      <li><a href={moi.linkedin} class="underline-offset-4 hover:underline">LinkedIn</a></li>
      <li><a href={moi.github} class="underline-offset-4 hover:underline">GitHub</a></li>
    </ul>
  </div>
</section>

<script>
  // copie l'email au clic et affiche "Copié !" 2 secondes
  const btn = document.getElementById("copier-email");
  btn?.addEventListener("click", async () => {
    await navigator.clipboard.writeText(btn.dataset.email ?? "");
    const avant = btn.textContent;
    btn.textContent = "Copié !";
    setTimeout(() => (btn.textContent = avant), 2000);
  });
</script>
