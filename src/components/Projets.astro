---
import { getCollection } from "astro:content";
import CarteProjet from "./CarteProjet.astro";
import CarteAutres from "./CarteAutres.astro";

const projets = (await getCollection("projets", (p) => p.data.aLaUne))
  .sort((a, b) => a.data.ordre - b.data.ordre);

const fleche = "flex h-11 w-11 items-center justify-center rounded-full border border-bordure transition hover:border-accent hover:text-accent disabled:opacity-30 disabled:hover:border-bordure disabled:hover:text-texte";
---
<section id="projets" class="mx-auto max-w-[1120px] px-6 py-16 md:py-24">
  <div class="mb-10 flex items-end justify-between gap-4">
    <div>
      <p class="text-sm font-medium tracking-wide text-corail uppercase">Projets</p>
      <h2 class="mt-2 font-titre text-3xl font-extrabold tracking-tight md:text-4xl">Ce que j'ai construit</h2>
    </div>

    <!-- flèches du carrousel (cachées s'il n'y a rien à faire défiler) -->
    <div id="carrousel-fleches" class="hidden gap-2">
      <button type="button" data-sens="-1" class={fleche} aria-label="Projets précédents">←</button>
      <button type="button" data-sens="1" class={fleche} aria-label="Projets suivants">→</button>
    </div>
  </div>

  <ul id="carrousel" class="-mx-6 flex snap-x snap-mandatory gap-6 overflow-x-auto scroll-px-6 px-6 pb-4 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
    {projets.map((projet) => (
      <li class="w-[85%] shrink-0 snap-start sm:w-[calc((100%-1.5rem)/2)] lg:w-[calc((100%-3rem)/3)]">
        <CarteProjet projet={projet} />
      </li>
    ))}
    <li class="w-[85%] shrink-0 snap-start sm:w-[calc((100%-1.5rem)/2)] lg:w-[calc((100%-3rem)/3)]">
      <CarteAutres />
    </li>
  </ul>
</section>

<script>
  // affiche les flèches seulement si les cartes dépassent, et fait défiler d'une carte
  const liste = document.getElementById("carrousel");
  const fleches = document.getElementById("carrousel-fleches");
  const btns = fleches?.querySelectorAll("button");

  function maj() {
    if (!liste || !fleches || !btns) return;
    const deborde = liste.scrollWidth > liste.clientWidth + 2;
    fleches.classList.toggle("hidden", !deborde);
    fleches.classList.toggle("flex", deborde);
    btns[0].disabled = liste.scrollLeft < 5;
    btns[1].disabled = liste.scrollLeft + liste.clientWidth > liste.scrollWidth - 5;
  }

  btns?.forEach((b) =>
    b.addEventListener("click", () => {
      const carte = liste?.querySelector("li");
      const pas = (carte?.clientWidth ?? 300) + 24;
      liste?.scrollBy({ left: pas * Number(b.dataset.sens), behavior: "smooth" });
    })
  );
  liste?.addEventListener("scroll", maj, { passive: true });
  window.addEventListener("resize", maj);
  maj();
</script>
