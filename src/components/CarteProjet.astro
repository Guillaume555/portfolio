---
import Apercu from "./Apercu.astro";

const { projet } = Astro.props;
const p = projet.data;
const pastille = p.teinte === "corail" ? "bg-corail-doux text-corail" : "bg-accent-doux text-accent";
---
<article class="flex h-full flex-col overflow-hidden rounded-[20px] border border-bordure bg-surface">
  <Apercu capture={p.capture} domaine={p.domaine ?? p.titre} titre={p.titre} teinte={p.teinte} />

  <div class="flex flex-1 flex-col p-6">
    <div class="flex items-center justify-between gap-3">
      <span class:list={["rounded-full px-2.5 py-1 text-[11px] font-medium tracking-wider uppercase", pastille]}>{p.type}</span>
      <span class="text-xs text-texte-doux">{p.annee}</span>
    </div>

    <h3 class="mt-4 font-titre text-2xl font-extrabold">{p.titre}<span class="text-corail">.</span></h3>
    <p class="mt-2 line-clamp-3 text-sm text-texte-doux">{p.resume}</p>

    <div class="mt-auto flex items-end justify-between gap-4 pt-6">
      <p class="text-xs text-texte-doux">{p.stack.slice(0, 3).join(" · ")}</p>
      <a href={`/projets/${projet.id}`} class="shrink-0 text-sm font-medium text-accent hover:underline">
        Voir <span aria-hidden="true">→</span><span class="sr-only"> l'étude de cas {p.titre}</span>
      </a>
    </div>
  </div>
</article>
