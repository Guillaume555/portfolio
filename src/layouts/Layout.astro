---
import "../styles/global.css";

const {
  titre = "Guillaume | Développeur full-stack",
  description = "Portfolio de Guillaume, développeur full-stack junior en recherche d'alternance.",
} = Astro.props;
---
<!doctype html>
<html lang="fr" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{titre}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@600;800&family=DM+Sans:wght@400;500&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-fond text-texte font-texte antialiased">
    <slot />
  </body>
</html>
